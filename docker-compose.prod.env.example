POSTGRES_DB=infra_memory
POSTGRES_USER=aime
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD

# Generate once with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=GENERATE_A_FERNET_KEY

AWS_SESSION_DURATION_SECONDS=900
CORS_ALLOWED_ORIGINS=https://app.example.com
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_NAME=aime_session

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=AIME <no-reply@example.com>
SMTP_USE_TLS=true
PASSWORD_RESET_URL=https://app.example.com/reset-password
EMAIL_VERIFICATION_URL=https://app.example.com/verify-email
