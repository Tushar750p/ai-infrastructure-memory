# AIME backend environment template
# Copy to backend/.env and replace every secret/value for your deployment.

DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME@localhost:5432/infra_memory
REDIS_URL=redis://localhost:6379/0
CREDENTIALS_ENCRYPTION_KEY=GENERATE_A_FERNET_KEY

AWS_SESSION_DURATION_SECONDS=900

# Frontend origin(s), comma-separated if multiple.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Production: true when served over HTTPS.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_NAME=aime_session

# Password-reset email delivery.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=AIME <no-reply@example.com>
SMTP_USE_TLS=true

# Public frontend URL used in password-reset links.
PASSWORD_RESET_URL=http://localhost:3000/reset-password
